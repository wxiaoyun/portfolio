---
import { BentoGrid, BentoGridItem } from "@/components/BentoGrid";
import { Separator } from "@/components/ui/separator";
import {
  openSourceContrib,
  professionalExperiences,
  projects,
} from "@/constants/experience";
import Layout from "@/layouts/Layout.astro";

const selfIntro = `I am a developer living in Singapore.
Just a casual enjoyer of Rust 🦀, Go and Typescript. I am interested in Programming Languages and Parallel Computing.`;
---

<Layout title="Wu Xiaoyun - About Me">
  <section>
    <h3 class="scroll-m-20 text-2xl font-semibold tracking-tight">
      Wu Xiaoyun
    </h3>
    <p class="scroll-m-20 text-md tracking-tight">
      {selfIntro}
    </p>
  </section>

  <Separator />

  <section>
    <h3 class="scroll-m-20 text-2xl font-semibold tracking-tight">
      Professional Experience
    </h3>
    <BentoGrid class="mt-6">
      {professionalExperiences.map((props) => <BentoGridItem {...props} />)}
    </BentoGrid>
  </section>

  <Separator />

  <section>
    <h3 class="scroll-m-20 text-2xl font-semibold tracking-tight">
      Open Source Contributions
    </h3>
    <BentoGrid class="mt-6">
      {openSourceContrib.map((props) => <BentoGridItem {...props} />)}
    </BentoGrid>
  </section>

  <Separator />

  <section>
    <h3 class="scroll-m-20 text-2xl font-semibold tracking-tight">Projects</h3>
    <BentoGrid class="mt-6">
      {projects.map((props) => <BentoGridItem {...props} />)}
    </BentoGrid>
  </section>
</Layout>
